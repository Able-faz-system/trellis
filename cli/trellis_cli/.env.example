# Trellis CLI — environment configuration
#
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# Priority order (highest to lowest):
#   1. CLI flags (where applicable)
#   2. Exported environment variables  (export TRELLIS_CONTRACT_ID=…)
#   3. Values in this .env file
#
# The .env file is loaded automatically at startup via dotenvy. To load a
# file from anywhere else, pass `--env-file <path>` or set TRELLIS_ENV_FILE.
# Never commit a .env file that contains real secret keys.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bech32-encoded Trellis contract address on the target network.
# Obtain this after deploying the contract (see DEPLOYMENT.md).
TRELLIS_CONTRACT_ID=CAUAO7CYKULE2K4EJMQ6LLRUHP7Y7JYOH6G2VBXKYG7PTETE3UZ3DU7Q

# Stellar secret key (S…) or a named identity managed by the stellar CLI.
# Example identity: stellar keys generate alice --network testnet
TRELLIS_SOURCE_KEY=your-identity-name-or-S-key

# ---------------------------------------------------------------------------
# Optional — Soroban Testnet is used when these are unset
# ---------------------------------------------------------------------------

# Soroban JSON-RPC endpoint.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase used to sign transactions.
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Number of automatic retries for transient Soroban RPC failures such as
# timeouts, rate limits and temporary "unavailable" / 5xx responses. Each
# retry waits longer than the last (exponential backoff + jitter). Only
# errors that look transient are retried; a missing `stellar` binary or a
# genuine contract error fails immediately.
# Set to 0 to disable retries entirely.
# Default: 3
# STELLAR_RPC_RETRIES=3
