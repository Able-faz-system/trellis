# Mainnet configuration template — copy to .env.mainnet and fill in the
# audited, reviewed deployment. NEVER commit real values or any secret keys.
VITE_CONTRACT_ID=
VITE_RPC_URL=https://mainnet.sorobanrpc.com
VITE_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Optional: lets the in-app network switcher target mainnet from a testnet build.
VITE_CONTRACT_ID_MAINNET=
