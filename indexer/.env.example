# Soroban RPC endpoint the indexer polls (once, on behalf of every client).
RPC_URL=https://soroban-testnet.stellar.org
# Contract whose events are indexed.
CONTRACT_ID=CAUAO7CYKULE2K4EJMQ6LLRUHP7Y7JYOH6G2VBXKYG7PTETE3UZ3DU7Q
# SQLite database file. Back this file up — it is the only copy of events
# older than the RPC node's retention window.
DB_PATH=./data/trellis-events.db
# HTTP port for the query API and SSE stream.
PORT=8787
# How often to poll getEvents, in milliseconds.
POLL_INTERVAL_MS=5000
# Value of Access-Control-Allow-Origin. Set to the frontend's origin in production.
CORS_ORIGIN=*
